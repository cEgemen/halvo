{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@utils/*":["./src/utils/*"],
      "@configs/*":["./src/configs/*"],
      "@routes/*":["./src/routes/*"],
      "@modules/*":["./src/modules/*"]
    }
  },
  "include": ["src"]
}
